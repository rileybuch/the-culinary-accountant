---
import '../styles/global.css';
import { business, instagram } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${business.name} | Custom Cookies & Treats in ${business.locationShort}`,
  description = `${business.tagline} Birthdays, weddings, holidays and events. Order via Instagram ${instagram.handle}.`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Structured data lets search engines show the business name, location and social
// profile directly in results, which matters for "cookies near me" style searches.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: business.name,
  description: business.tagline,
  url: Astro.site?.toString(),
  address: { '@type': 'PostalAddress', addressLocality: 'Charlotte', addressRegion: 'NC', addressCountry: 'US' },
  sameAs: [instagram.url],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#F6F2EB" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-ivory font-body text-ink antialiased">
    <slot />
  </body>
</html>
