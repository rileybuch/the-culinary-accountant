---
import { Picture, getImage } from 'astro:assets';
import InstagramIcon from './InstagramIcon.astro';
import { gallery, instagram } from '../data/site';

const categories = ['All', ...new Set(gallery.map((item) => item.category))];
const tilts = ['-rotate-2', 'rotate-1', 'rotate-2', '-rotate-1', 'rotate-1', '-rotate-2'];

// One compressed large rendition per photo for the lightbox, so opening an image never
// downloads the camera original.
const items = await Promise.all(
  gallery.map(async (item) => ({
    ...item,
    full: (await getImage({ src: item.src, width: 1600, format: 'webp' })).src,
  })),
);
---

<section id="gallery" class="py-24 bg-blush">
  <div class="max-w-6xl mx-auto px-5">
    <div class="text-center mb-10">
      <span class="eyebrow mb-5">Fresh from the oven</span>
      <h2 class="font-display font-bold text-4xl md:text-6xl mb-4">Recent sweet things</h2>
      <p class="text-lg text-cocoa/75 max-w-md mx-auto">Every set is designed from scratch for its party. Tap a photo for a closer look.</p>
    </div>

    <div class="flex flex-wrap justify-center gap-3 mb-12" role="group" aria-label="Filter treats">
      {categories.map((category, i) => (
        <button
          type="button"
          data-filter={category}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class="filter-btn rounded-full border-2 border-cocoa bg-white px-5 py-2 font-display font-semibold transition-colors aria-pressed:bg-cocoa aria-pressed:text-sugar hover:bg-butter aria-pressed:hover:bg-cocoa"
        >
          {category}
        </button>
      ))}
    </div>

    <ul class="grid grid-cols-2 lg:grid-cols-5 gap-5 md:gap-6">
      {items.map((item, i) => (
        <li class="gallery-item" data-category={item.category}>
          <button
            type="button"
            class:list={['polaroid block w-full text-left transition-transform hover:rotate-0 hover:-translate-y-1 focus-visible:rotate-0 focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-berry', tilts[i % tilts.length]]}
            data-full={item.full}
            data-alt={item.alt}
            data-caption={item.caption}
            aria-label={`View larger: ${item.caption}`}
          >
            <Picture src={item.src} alt={item.alt} widths={[300, 460, 620]} sizes="(min-width: 1024px) 210px, 46vw" formats={['avif', 'webp']} class="w-full aspect-square object-cover rounded" />
            <span class="block font-display font-semibold text-sm md:text-base mt-3 leading-tight">{item.caption}</span>
            <span class="block text-xs font-bold uppercase tracking-wider text-berry mt-1">{item.occasion}</span>
          </button>
        </li>
      ))}
    </ul>

    <div class="text-center mt-14">
      <a href={instagram.url} target="_blank" rel="noopener" class="btn-pop bg-butter">
        <InstagramIcon size={18} />
        See more on {instagram.handle}
      </a>
    </div>
  </div>

  <dialog id="lightbox" class="m-auto bg-transparent p-0 max-w-[min(92vw,1000px)] backdrop:bg-cocoa/80" aria-label="Photo viewer">
    <figure class="polaroid relative !p-3 !pb-5">
      <img id="lightbox-img" src="" alt="" class="max-h-[78vh] w-auto mx-auto rounded" />
      <figcaption id="lightbox-caption" class="font-display font-semibold text-xl text-center mt-3"></figcaption>
      <button id="lightbox-close" type="button" class="absolute -top-4 -right-4 w-11 h-11 rounded-full bg-pink border-2 border-cocoa font-display text-2xl leading-none" aria-label="Close photo viewer">&times;</button>
    </figure>
  </dialog>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const galleryItems = document.querySelectorAll<HTMLElement>('.gallery-item');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      galleryItems.forEach((item) => {
        item.hidden = btn.dataset.filter !== 'All' && item.dataset.category !== btn.dataset.filter;
      });
    });
  });

  // Native <dialog> handles focus trapping and Escape-to-close without a library.
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const caption = document.getElementById('lightbox-caption');
  document.querySelectorAll<HTMLButtonElement>('[data-full]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!dialog || !img || !caption) return;
      img.src = trigger.dataset.full ?? '';
      img.alt = trigger.dataset.alt ?? '';
      caption.textContent = trigger.dataset.caption ?? '';
      dialog.showModal();
    });
  });
  document.getElementById('lightbox-close')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
