---
import { Picture, getImage } from 'astro:assets';
import { gallery, instagram } from '../data/site';

// Hand-tuned 12-column placements: offsets and mixed aspect ratios create the rhythm
// of a magazine spread instead of a uniform product grid. Index-aligned with `gallery`.
const layout = [
  { span: 'md:col-start-1 md:col-end-8', aspect: 'aspect-[4/5]' },
  { span: 'md:col-start-9 md:col-end-13 md:mt-40', aspect: 'aspect-[3/4]' },
  { span: 'md:col-start-2 md:col-end-6', aspect: 'aspect-square' },
  { span: 'md:col-start-7 md:col-end-13 md:mt-24', aspect: 'aspect-[4/3]' },
  { span: 'md:col-start-1 md:col-end-5', aspect: 'aspect-[3/4]' },
  { span: 'md:col-start-6 md:col-end-12 md:mt-32', aspect: 'aspect-[5/4]' },
  { span: 'md:col-start-3 md:col-end-7', aspect: 'aspect-square' },
  { span: 'md:col-start-8 md:col-end-13 md:mt-20', aspect: 'aspect-[4/5]' },
  { span: 'md:col-start-1 md:col-end-7', aspect: 'aspect-[4/3]' },
  { span: 'md:col-start-8 md:col-end-12 md:mt-28', aspect: 'aspect-[3/4]' },
];

// The hero already leads with the first photo; rotate it to the end so the portfolio
// opens on something new instead of repeating the image directly above it.
const ordered = [...gallery.slice(1), gallery[0]];

const items = await Promise.all(
  ordered.map(async (item, i) => ({
    ...item,
    ...layout[i % layout.length],
    number: String(i + 1).padStart(2, '0'),
    // Large compressed rendition for the lightbox so the camera original is never sent.
    full: (await getImage({ src: item.src, width: 1600, format: 'webp' })).src,
  })),
);
---

<section id="portfolio" class="border-t border-ink/10">
  <div class="max-w-7xl mx-auto px-5 md:px-10 py-24 md:py-32">
    <div class="grid md:grid-cols-12 gap-6 mb-20 md:mb-28">
      <p class="kicker md:col-span-3">No. 01 &mdash; Portfolio</p>
      <h2 class="md:col-span-9 font-display text-4xl md:text-6xl leading-[1.05] max-w-3xl">
        Each piece is <em>designed for its occasion</em>, then piped, painted and finished by hand.
      </h2>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-12 gap-x-6 gap-y-16 md:gap-y-24">
      {items.map((item) => (
        <li class={item.span}>
          <button
            type="button"
            class="group block w-full text-left focus-visible:outline-1 focus-visible:outline-offset-8 focus-visible:outline-ink"
            data-full={item.full}
            data-alt={item.alt}
            data-caption={item.caption}
            aria-label={`View larger: ${item.caption}`}
          >
            <div class:list={['overflow-hidden bg-linen', item.aspect]}>
              <Picture src={item.src} alt={item.alt} widths={[400, 700, 1000]} sizes="(min-width: 768px) 50vw, 100vw" formats={['avif', 'webp']} class="w-full h-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-[1.04]" />
            </div>
            <div class="flex items-baseline gap-4 mt-4 border-t border-ink/15 pt-3">
              <span class="font-display italic text-taupe text-lg">{item.number}</span>
              <span class="font-display text-xl">{item.caption}</span>
              <span class="kicker !text-mute ml-auto">{item.occasion}</span>
            </div>
          </button>
        </li>
      ))}
    </ul>

    <div class="mt-24 text-center">
      <a href={instagram.url} target="_blank" rel="noopener" class="link-draw">
        The full archive on Instagram, {instagram.handle} <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>

  <dialog id="lightbox" class="m-auto max-w-[min(94vw,1100px)] bg-ivory p-4 md:p-6 backdrop:bg-ink/90" aria-label="Photo viewer">
    <figure>
      <img id="lightbox-img" src="" alt="" class="max-h-[78vh] w-auto mx-auto" />
      <figcaption class="flex items-baseline justify-between gap-6 mt-4">
        <span id="lightbox-caption" class="font-display text-2xl"></span>
        <button id="lightbox-close" type="button" class="kicker !text-ink hover:!text-taupe">Close &times;</button>
      </figcaption>
    </figure>
  </dialog>
</section>

<script>
  // Native <dialog> gives focus trapping and Escape-to-close without a library.
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const caption = document.getElementById('lightbox-caption');
  document.querySelectorAll<HTMLButtonElement>('[data-full]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!dialog || !img || !caption) return;
      img.src = trigger.dataset.full ?? '';
      img.alt = trigger.dataset.alt ?? '';
      caption.textContent = trigger.dataset.caption ?? '';
      dialog.showModal();
    });
  });
  document.getElementById('lightbox-close')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
