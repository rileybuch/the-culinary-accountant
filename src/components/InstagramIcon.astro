---
interface Props {
  size?: number;
  class?: string;
}
const { size = 18, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
  <circle cx="12" cy="12" r="4.2" />
  <circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" stroke="none" />
</svg>
