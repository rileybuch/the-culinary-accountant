---
import { Picture } from 'astro:assets';
import { about, aboutImage, business } from '../data/site';
---

<section id="about" class="py-24">
  <div class="max-w-6xl mx-auto px-5 grid md:grid-cols-2 gap-14 items-center">
    <div class="relative max-w-md mx-auto w-full">
      <div class="absolute inset-0 translate-x-4 translate-y-4 bg-mint border-2 border-cocoa" style="border-radius: 58% 42% 55% 45% / 45% 55% 45% 55%;"></div>
      <div class="relative overflow-hidden border-2 border-cocoa aspect-square" style="border-radius: 58% 42% 55% 45% / 45% 55% 45% 55%;">
        <Picture src={aboutImage.src} alt={aboutImage.alt} widths={[400, 700]} sizes="(min-width: 768px) 440px, 90vw" formats={['avif', 'webp']} class="w-full h-full object-cover" />
      </div>
    </div>
    <div>
      <span class="eyebrow mb-5">{about.eyebrow}</span>
      <h2 class="font-display font-bold text-4xl md:text-5xl leading-tight mb-6">
        Sweet treats, <span class="text-berry">carefully</span> counted.
      </h2>
      {about.paragraphs.map((p) => <p class="text-lg text-cocoa/80 leading-relaxed mb-5">{p}</p>)}
      <p class="inline-flex items-center gap-2 font-display font-semibold mt-3">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="#F28DB2" stroke="#3B2420" stroke-width="1.5" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" /><circle cx="12" cy="9" r="2.5" fill="#FFF8F0" /></svg>
        {business.location}
      </p>
    </div>
  </div>
</section>
