---
import { Picture } from 'astro:assets';
import { about, aboutImage, business } from '../data/site';
---

<section id="about" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <div class="relative order-2 md:order-1">
        <div class="aspect-[4/5] rounded-2xl overflow-hidden shadow-lg">
          <Picture
            src={aboutImage.src}
            alt={aboutImage.alt}
            widths={[400, 700, 1000]}
            sizes="(min-width: 768px) 520px, 100vw"
            formats={['avif', 'webp']}
            class="w-full h-full object-cover"
          />
        </div>
        <div class="absolute -bottom-5 -right-5 w-28 h-28 rounded-2xl bg-secondary/20 -z-10"></div>
        <div class="absolute -top-5 -left-5 w-20 h-20 rounded-full bg-primary/10 -z-10"></div>
      </div>

      <div class="order-1 md:order-2">
        <p class="text-secondary uppercase tracking-[0.25em] text-xs font-semibold mb-5">{about.eyebrow}</p>
        <h2 class="font-display text-4xl md:text-5xl text-charcoal mb-7 leading-tight">{about.heading}</h2>
        {about.paragraphs.map((p, i) => (
          <p class:list={['text-charcoal/65 leading-relaxed mb-5', { 'text-lg': i === 0 }]}>{p}</p>
        ))}
        <div class="flex items-center gap-3 text-primary font-medium mt-8">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" />
            <circle cx="12" cy="9" r="2.5" />
          </svg>
          <span>{business.location}</span>
        </div>
      </div>
    </div>
  </div>
</section>
