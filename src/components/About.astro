---
import { Picture } from 'astro:assets';
import { about, aboutImage, business } from '../data/site';
---

<section id="about" class="border-t border-ink/10">
  <div class="max-w-7xl mx-auto px-5 md:px-10 py-24 md:py-32 grid md:grid-cols-12 gap-12 md:gap-6 items-center">
    <div class="md:col-span-5">
      <div class="arch overflow-hidden aspect-[3/4]">
        <Picture src={aboutImage.src} alt={aboutImage.alt} widths={[400, 700]} sizes="(min-width: 768px) 40vw, 100vw" formats={['avif', 'webp']} class="w-full h-full object-cover" />
      </div>
    </div>
    <div class="md:col-start-7 md:col-span-6">
      <p class="kicker mb-8">No. 04 &mdash; {about.eyebrow}</p>
      <h2 class="font-display text-4xl md:text-[3.25rem] leading-[1.08] mb-10">{about.heading}</h2>
      {about.paragraphs.map((p) => <p class="text-mute leading-relaxed mb-5 max-w-lg">{p}</p>)}
      <p class="kicker !text-ink mt-8">{business.location}</p>
    </div>
  </div>
</section>
