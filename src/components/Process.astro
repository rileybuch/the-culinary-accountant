---
import { orderSteps, primaryCta } from '../data/site';

const numerals = ['I', 'II', 'III', 'IV'];
---

<section id="process" class="max-w-7xl mx-auto px-5 md:px-10 py-24 md:py-32">
  <div class="grid md:grid-cols-12 gap-6 mb-16">
    <p class="kicker md:col-span-3">No. 03 &mdash; The Process</p>
    <h2 class="md:col-span-9 font-display text-4xl md:text-6xl leading-[1.05]">From first message to <em>final flourish.</em></h2>
  </div>

  <ol class="grid md:grid-cols-12 gap-6">
    <li class="hidden md:block md:col-span-3" aria-hidden="true"></li>
    {orderSteps.map(({ title, description }, i) => (
      <li class="md:col-span-3 border-t border-ink pt-6">
        <p class="font-display italic text-5xl text-taupe mb-6">{numerals[i]}</p>
        <h3 class="font-display text-2xl mb-3">{title}</h3>
        <p class="text-mute leading-relaxed text-[15px]">{description}</p>
      </li>
    ))}
  </ol>

  <div class="grid md:grid-cols-12 gap-6 mt-16">
    <div class="md:col-start-4 md:col-span-9">
      <a href={primaryCta.href} target="_blank" rel="noopener" class="link-draw">
        {primaryCta.label} <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>
