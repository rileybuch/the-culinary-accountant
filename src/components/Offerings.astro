---
import { Picture } from 'astro:assets';
import { offerings } from '../data/site';
---

<section id="menu" class="py-24 bg-cream">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <p class="text-secondary uppercase tracking-[0.25em] text-xs font-semibold mb-5">What We Make</p>
      <h2 class="font-display text-4xl md:text-5xl text-charcoal leading-tight">
        Made to Order, Down to the Last Detail
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-7">
      {offerings.map(({ title, description, image }) => (
        <article class="bg-white rounded-2xl overflow-hidden border-t-4 border-primary shadow-sm hover:shadow-md transition-shadow flex flex-col">
          <div class="aspect-[4/3] overflow-hidden">
            <Picture
              src={image.src}
              alt={image.alt}
              widths={[360, 560, 760]}
              sizes="(min-width: 768px) 360px, 100vw"
              formats={['avif', 'webp']}
              class="w-full h-full object-cover"
            />
          </div>
          <div class="p-8">
            <h3 class="font-display text-2xl text-charcoal mb-3">{title}</h3>
            <p class="text-charcoal/60 leading-relaxed">{description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
