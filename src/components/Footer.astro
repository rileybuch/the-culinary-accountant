---
import InstagramIcon from './InstagramIcon.astro';
import { business, instagram } from '../data/site';
---

<footer class="bg-charcoal text-cream/70 py-10 pb-28 md:pb-10 text-center">
  <p class="font-display text-xl text-cream mb-1">{business.name}</p>
  <p class="text-sm">{business.location}</p>
  <a
    href={instagram.url}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-2 mt-5 text-sm text-cream/70 hover:text-secondary transition-colors"
  >
    <InstagramIcon size={16} />
    {instagram.handle}
  </a>
  <p class="mt-6 text-xs text-cream/30">
    &copy; {new Date().getFullYear()} {business.name}. All rights reserved.
  </p>
</footer>
