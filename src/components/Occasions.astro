---
import { occasions } from '../data/site';

// Icons are keyed by position to keep presentation concerns out of the shared data file.
const icons = [
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 12v10H4V12"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>`,
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l2.4 7.2H22l-6 4.6 2.3 7.2-6.3-4.5-6.3 4.5L8 13.8 2 9.2h7.6z"/></svg>`,
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
];
---

<section id="occasions" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16">
      <p class="text-secondary uppercase tracking-[0.25em] text-xs font-semibold mb-5">Occasions</p>
      <h2 class="font-display text-4xl md:text-5xl text-charcoal leading-tight">
        Every Occasion, Perfectly Served
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {occasions.map(({ title, description }, i) => (
        <div class="rounded-2xl p-7 bg-cream/60 border border-primary/10">
          <div class="text-secondary mb-5" set:html={icons[i % icons.length]} />
          <h3 class="font-display text-xl text-charcoal mb-2">{title}</h3>
          <p class="text-charcoal/60 text-sm leading-relaxed">{description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
