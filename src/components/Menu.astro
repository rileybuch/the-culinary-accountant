---
import { Picture } from 'astro:assets';
import { occasions, offerings } from '../data/site';

// Each card takes one icing color so the three offerings are distinguishable at a glance.
const cardColors = ['bg-pink', 'bg-butter', 'bg-mint'];
const occasionColors = ['bg-sky', 'bg-blush', 'bg-butter', 'bg-mint'];
---

<section id="menu" class="py-24">
  <div class="max-w-6xl mx-auto px-5">
    <div class="text-center mb-14">
      <span class="eyebrow mb-5">The menu</span>
      <h2 class="font-display font-bold text-4xl md:text-6xl">What we bake</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mb-24">
      {offerings.map(({ title, description, image }, i) => (
        <article class:list={['rounded-[2rem] border-2 border-cocoa p-6 pt-8 text-center shadow-[6px_6px_0_var(--color-cocoa)]', cardColors[i % cardColors.length]]}>
          <div class="w-44 h-44 mx-auto mb-6 rounded-full overflow-hidden border-2 border-cocoa bg-white">
            <Picture src={image.src} alt={image.alt} widths={[200, 400]} sizes="176px" formats={['avif', 'webp']} class="w-full h-full object-cover" />
          </div>
          <h3 class="font-display font-bold text-2xl mb-3">{title}</h3>
          <p class="text-cocoa/85 leading-relaxed">{description}</p>
        </article>
      ))}
    </div>

    <div class="text-center mb-10">
      <h2 class="font-display font-bold text-3xl md:text-5xl">Perfect for...</h2>
    </div>
    <ul class="grid sm:grid-cols-2 gap-5">
      {occasions.map(({ title, description }, i) => (
        <li class:list={['flex gap-5 items-start rounded-3xl border-2 border-cocoa p-6', occasionColors[i % occasionColors.length]]}>
          <span class="shrink-0 w-12 h-12 rounded-full bg-white border-2 border-cocoa flex items-center justify-center font-display font-bold text-xl">{i + 1}</span>
          <div>
            <h3 class="font-display font-bold text-xl mb-1">{title}</h3>
            <p class="text-cocoa/80">{description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
