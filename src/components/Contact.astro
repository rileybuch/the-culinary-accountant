---
import InstagramIcon from './InstagramIcon.astro';
import { business, contact, instagram, primaryCta } from '../data/site';
---

<section
  id="contact"
  class="py-28 text-center"
  style="background: linear-gradient(150deg, #162b09 0%, #2D5A1B 45%, #1a3a0a 100%);"
>
  <div class="max-w-2xl mx-auto px-6">
    <p class="text-secondary uppercase tracking-[0.25em] text-xs font-semibold mb-5">Get in Touch</p>
    <h2 class="font-display text-4xl md:text-5xl text-cream mb-6 leading-tight">
      Let's Create Something Memorable
    </h2>
    <p class="text-cream/65 text-lg leading-relaxed mb-10">
      Planning a birthday, shower, holiday or event? Send us your date and your idea and
      we will take it from there.
    </p>

    <a
      href={primaryCta.href}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2.5 bg-secondary text-charcoal font-semibold px-9 py-4 rounded text-xs uppercase tracking-[0.2em] hover:bg-secondary/90 transition-colors"
    >
      <InstagramIcon size={16} />
      {primaryCta.label}
    </a>

    <ul class="mt-12 flex flex-col sm:flex-row flex-wrap justify-center gap-4 text-sm">
      <li>
        <a
          href={instagram.url}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2.5 bg-cream/10 border border-cream/15 rounded-full px-6 py-3 text-cream/80 hover:text-cream hover:bg-cream/15 transition-colors"
        >
          <InstagramIcon size={15} />
          {instagram.handle}
        </a>
      </li>
      {contact.email && (
        <li>
          <a
            href={`mailto:${contact.email}`}
            class="inline-flex items-center gap-2.5 bg-cream/10 border border-cream/15 rounded-full px-6 py-3 text-cream/80 hover:text-cream transition-colors"
          >
            {contact.email}
          </a>
        </li>
      )}
      {contact.phone && (
        <li>
          <a
            href={`tel:${contact.phone.replace(/[^\d+]/g, '')}`}
            class="inline-flex items-center gap-2.5 bg-cream/10 border border-cream/15 rounded-full px-6 py-3 text-cream/80 hover:text-cream transition-colors"
          >
            {contact.phone}
          </a>
        </li>
      )}
      <li class="inline-flex items-center justify-center gap-2.5 rounded-full px-6 py-3 text-cream/55">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" />
          <circle cx="12" cy="9" r="2.5" />
        </svg>
        {business.location}
      </li>
    </ul>
  </div>
</section>
