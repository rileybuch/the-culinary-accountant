---
import InstagramIcon from './InstagramIcon.astro';
import { business, contact, instagram, primaryCta } from '../data/site';
---

<section id="contact" class="bg-ink text-ivory">
  <div class="max-w-7xl mx-auto px-5 md:px-10 py-28 md:py-40 text-center">
    <p class="kicker mb-10">No. 05 &mdash; Enquiries</p>
    <h2 class="font-display text-5xl sm:text-7xl md:text-8xl leading-[0.95] mb-10">
      Let us make it<br /><em class="text-taupe">memorable.</em>
    </h2>
    <p class="text-ivory/60 max-w-md mx-auto mb-12 leading-relaxed">
      Share your date, your theme and your guest count. We will reply with ideas and next steps.
    </p>
    <a href={primaryCta.href} target="_blank" rel="noopener" class="inline-flex items-center gap-3 border border-ivory/80 px-9 py-4 kicker !text-ivory hover:bg-ivory hover:!text-ink transition-colors">
      <InstagramIcon size={15} />
      {primaryCta.label}
    </a>
    <ul class="mt-16 flex flex-wrap justify-center gap-x-10 gap-y-3 kicker !text-ivory/50">
      <li><a href={instagram.url} target="_blank" rel="noopener" class="hover:!text-ivory">{instagram.handle}</a></li>
      {contact.email && <li><a href={`mailto:${contact.email}`} class="hover:!text-ivory">{contact.email}</a></li>}
      {contact.phone && <li><a href={`tel:${contact.phone.replace(/[^\d+]/g, '')}`} class="hover:!text-ivory">{contact.phone}</a></li>}
      <li>{business.location}</li>
    </ul>
  </div>
  <footer class="border-t border-ivory/10 py-8 pb-24 md:pb-8 text-center kicker !text-ivory/35">
    &copy; {new Date().getFullYear()} {business.name}
  </footer>
</section>

<!-- Persistent enquiry bar on phones, styled as a quiet strip so it does not cheapen the look. -->
<a
  href={primaryCta.href}
  target="_blank"
  rel="noopener"
  class="md:hidden fixed inset-x-0 bottom-0 z-40 bg-ink text-ivory text-center py-4 kicker !text-ivory"
>
  Enquire on Instagram &rarr;
</a>
