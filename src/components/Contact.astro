---
import InstagramIcon from './InstagramIcon.astro';
import { business, contact, instagram, primaryCta } from '../data/site';
---

<section id="contact" class="px-5 pb-24">
  <div class="relative max-w-5xl mx-auto rounded-[2.5rem] bg-pink border-2 border-cocoa shadow-[8px_8px_0_var(--color-cocoa)] px-6 py-16 md:py-20 text-center overflow-hidden">
    <div class="absolute -top-10 -left-10 w-40 h-40 rounded-full bg-butter border-2 border-cocoa" aria-hidden="true"></div>
    <div class="absolute -bottom-14 -right-8 w-48 h-48 rounded-full bg-mint border-2 border-cocoa" aria-hidden="true"></div>
    <div class="relative">
      <h2 class="font-display font-bold text-4xl md:text-6xl leading-tight mb-5">Got a party coming up?</h2>
      <p class="text-lg md:text-xl max-w-xl mx-auto mb-9">Send your date, theme and guest count and we will dream up something delicious.</p>
      <a href={primaryCta.href} target="_blank" rel="noopener" class="btn-pop bg-white text-lg">
        <InstagramIcon size={20} />
        {primaryCta.label}
      </a>
      <ul class="flex flex-wrap justify-center gap-3 mt-10 font-display font-semibold">
        <li><a href={instagram.url} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-white/70 border-2 border-cocoa px-4 py-2 hover:bg-white"><InstagramIcon size={16} />{instagram.handle}</a></li>
        {contact.email && <li><a href={`mailto:${contact.email}`} class="inline-block rounded-full bg-white/70 border-2 border-cocoa px-4 py-2 hover:bg-white">{contact.email}</a></li>}
        {contact.phone && <li><a href={`tel:${contact.phone.replace(/[^\d+]/g, '')}`} class="inline-block rounded-full bg-white/70 border-2 border-cocoa px-4 py-2 hover:bg-white">{contact.phone}</a></li>}
        <li class="inline-block rounded-full bg-white/40 border-2 border-cocoa/40 px-4 py-2">{business.locationShort}</li>
      </ul>
    </div>
  </div>
</section>

<footer class="bg-cocoa text-sugar py-10 text-center">
  <p class="font-display font-bold text-2xl"><span class="text-pink">The Culinary</span> Accountant</p>
  <p class="text-sugar/70 mt-1">{business.tagline}</p>
  <p class="text-sugar/40 text-sm mt-5">&copy; {new Date().getFullYear()} {business.name}</p>
</footer>

<!-- Floating order button on phones; the header's order button scrolls with the page
     inside the pill, but this one stays in thumb reach at the bottom corner. -->
<a
  href={primaryCta.href}
  target="_blank"
  rel="noopener"
  class="md:hidden fixed bottom-4 right-4 z-40 inline-flex items-center gap-2 rounded-full bg-butter border-2 border-cocoa px-5 py-3 font-display font-semibold shadow-[3px_3px_0_var(--color-cocoa)]"
>
  <InstagramIcon size={18} />
  Order
</a>
