---
import { Picture } from 'astro:assets';
import InstagramIcon from './InstagramIcon.astro';
import { business, heroImages, occasions, primaryCta } from '../data/site';

const [main, second, third] = heroImages;
const badgeText = `made to order • ${business.locationShort} • `;
---

<section id="home" class="relative overflow-hidden pt-10 md:pt-16 pb-24">
  <!-- Scattered sprinkles: decorative only, kept as an inline SVG pattern so it costs no requests. -->
  <svg class="absolute inset-0 w-full h-full opacity-60 pointer-events-none" aria-hidden="true">
    <defs>
      <pattern id="sprinkles" width="160" height="160" patternUnits="userSpaceOnUse">
        <rect x="20" y="24" width="18" height="6" rx="3" fill="#F28DB2" transform="rotate(-30 29 27)" />
        <rect x="96" y="40" width="18" height="6" rx="3" fill="#A8DDB5" transform="rotate(20 105 43)" />
        <rect x="56" y="104" width="18" height="6" rx="3" fill="#FFE08A" transform="rotate(60 65 107)" />
        <rect x="124" y="120" width="18" height="6" rx="3" fill="#BFDDF5" transform="rotate(-50 133 123)" />
        <circle cx="70" cy="60" r="3.5" fill="#D9487D" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#sprinkles)" />
  </svg>

  <div class="relative max-w-6xl mx-auto px-5 grid lg:grid-cols-2 gap-14 items-center">
    <div class="text-center lg:text-left">
      <span class="eyebrow mb-6">Custom cookies &amp; treats in {business.locationShort}</span>
      <h1 class="font-display font-bold text-5xl sm:text-6xl md:text-7xl leading-[0.95] tracking-tight mb-6">
        Treats that
        <span class="relative inline-block text-berry">
          steal
          <svg class="absolute -bottom-2 left-0 w-full" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 14 Q 50 2 100 12 T 198 8" fill="none" stroke="#FFE08A" stroke-width="7" stroke-linecap="round" />
          </svg>
        </span>
        the party.
      </h1>
      <p class="text-lg md:text-xl max-w-lg mx-auto lg:mx-0 mb-9 text-cocoa/80">{business.pitch}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
        <a href={primaryCta.href} target="_blank" rel="noopener" class="btn-pop bg-pink">
          <InstagramIcon size={18} />
          {primaryCta.label}
        </a>
        <a href="#gallery" class="btn-pop bg-white">See the treats</a>
      </div>
    </div>

    <div class="relative h-[440px] sm:h-[520px] max-w-[520px] w-full mx-auto">
      <div class="polaroid absolute left-[4%] top-[8%] w-[58%] -rotate-6 z-10">
        <Picture src={main.src} alt={main.alt} widths={[360, 640]} sizes="320px" formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="w-full aspect-[4/5] object-cover rounded" />
        <p class="font-display font-semibold text-center mt-2 text-sm">{main.caption}</p>
      </div>
      <div class="polaroid absolute right-[2%] top-0 w-[44%] rotate-6">
        <Picture src={second.src} alt={second.alt} widths={[260, 520]} sizes="230px" formats={['avif', 'webp']} loading="eager" class="w-full aspect-square object-cover rounded" />
      </div>
      <div class="polaroid absolute right-[2%] bottom-[2%] w-[44%] rotate-3 z-20">
        <Picture src={third.src} alt={third.alt} widths={[260, 520]} sizes="240px" formats={['avif', 'webp']} loading="eager" class="w-full aspect-square object-cover rounded" />
        <p class="font-display font-semibold text-center mt-2 text-sm">{third.caption}</p>
      </div>
      <!-- Rotating sticker badge -->
      <div class="absolute -left-2 -top-2 z-30 w-28 h-28 sm:w-32 sm:h-32 rounded-full bg-butter border-2 border-cocoa flex items-center justify-center">
        <svg viewBox="0 0 100 100" class="absolute inset-0 animate-spin-slow" aria-hidden="true">
          <defs><path id="badge-circle" d="M50,50 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0" /></defs>
          <text font-family="Fredoka" font-weight="600" font-size="11" fill="#3B2420">
            <textPath href="#badge-circle" textLength="228" lengthAdjust="spacing">{badgeText.toUpperCase()}</textPath>
          </text>
        </svg>
        <span class="text-3xl" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="#D9487D"><path d="M12 21s-7-4.6-9.3-9.1C1.1 8.6 3 4.8 6.6 4.8c2.1 0 3.6 1.2 5.4 3.2 1.8-2 3.3-3.2 5.4-3.2 3.6 0 5.5 3.8 3.9 7.1C19 16.4 12 21 12 21z"/></svg>
        </span>
      </div>
    </div>
  </div>
</section>

<!-- Occasion marquee: quick scannable "is this for me?" signal right under the hero. -->
<div class="relative -rotate-1 bg-cocoa text-sugar border-y-2 border-cocoa overflow-hidden py-3" aria-label="Occasions we bake for">
  <div class="flex w-max animate-marquee font-display text-xl md:text-2xl font-semibold whitespace-nowrap">
    {[0, 1].map((copy) => (
      <ul class="flex items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
        {occasions.map(({ title }, i) => (
          <li class="flex items-center">
            <span class="px-6">{title}</span>
            <span class:list={['w-3 h-3 rounded-full', ['bg-pink', 'bg-butter', 'bg-mint', 'bg-sky'][i % 4]]}></span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
