---
import { Picture } from 'astro:assets';
import InstagramIcon from './InstagramIcon.astro';
import RedCircle from './RedCircle.astro';
import { business, heroImages, occasions, offerings, primaryCta } from '../data/site';

const [main] = heroImages;
---

<section id="home" class="graph-paper border-b-2 border-navy overflow-hidden">
  <div class="max-w-6xl mx-auto px-5 pt-14 md:pt-20 pb-20">
    <p class="label mb-6"><span class="text-redpen">&#9679;</span> {business.location} &nbsp;/&nbsp; Custom cookies, cupcakes &amp; desserts</p>
    <h1 class="font-display text-5xl sm:text-6xl md:text-8xl leading-[0.98] max-w-4xl mb-14">
      Every detail, <RedCircle>accounted</RedCircle> for.
    </h1>

    <div class="grid lg:grid-cols-12 gap-10 lg:gap-0 items-start">
      <div class="lg:col-span-7 lg:pr-10">
        <div class="relative border-2 border-navy bg-receipt p-3 shadow-[8px_8px_0_var(--color-navy)]">
          <Picture src={main.src} alt={main.alt} widths={[500, 800, 1100]} sizes="(min-width: 1024px) 620px, 100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="w-full aspect-[4/3] object-cover" />
          <p class="label mt-3 flex justify-between"><span>Exhibit A</span><span>{main.caption}</span></p>
        </div>
        <p class="text-lg text-graphite max-w-lg mt-10 mb-8 leading-relaxed">{business.pitch}</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={primaryCta.href} target="_blank" rel="noopener" class="btn-ledger"><InstagramIcon size={16} />{primaryCta.label}</a>
          <a href="#exhibits" class="btn-ledger-outline">Review the evidence</a>
        </div>
      </div>

      <!-- The "statement" receipt doubles as a scannable summary of what is offered. -->
      <aside class="lg:col-span-5 lg:-mt-6 relative" aria-label="Summary of what we make">
        <div class="receipt font-mono text-sm px-7 pt-8 shadow-[0_18px_40px_-20px_rgba(31,42,68,0.45)] rotate-[1.5deg]">
          <p class="text-center font-semibold tracking-[0.2em]">STATEMENT OF SWEETNESS</p>
          <p class="text-center text-graphite text-xs mt-1">{business.name.toUpperCase()}</p>
          <p class="text-center text-graphite text-xs">{business.locationShort.toUpperCase()}</p>
          <div class="border-t-2 border-dashed border-navy/40 my-5"></div>
          <p class="label mb-3">Line items</p>
          <ul class="space-y-2.5">
            {offerings.map(({ title }) => (
              <li class="flex items-baseline"><span>{title}</span><span class="leader"></span><span class="text-ledger font-semibold">&#10003;</span></li>
            ))}
          </ul>
          <p class="label mt-6 mb-3">Occasions covered</p>
          <ul class="space-y-2.5">
            {occasions.map(({ title }) => (
              <li class="flex items-baseline"><span>{title}</span><span class="leader"></span><span class="text-ledger font-semibold">&#10003;</span></li>
            ))}
          </ul>
          <div class="border-t-2 border-dashed border-navy/40 my-5"></div>
          <div class="flex items-baseline justify-between text-base font-semibold">
            <span>TOTAL</span><span>Made to order</span>
          </div>
          <div class="flex items-baseline justify-between text-graphite text-xs mt-1">
            <span>Details overlooked</span><span>0.00</span>
          </div>
          <div class="text-center mt-7">
            <span class="stamp text-lg -rotate-6">Approved</span>
          </div>
          <p class="text-center text-xs text-graphite mt-6">*** THANK YOU ***</p>
        </div>
      </aside>
    </div>
  </div>
</section>
