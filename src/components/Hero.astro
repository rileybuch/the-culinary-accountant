---
import { Picture } from 'astro:assets';
import { business, heroImages, primaryCta } from '../data/site';

const [main, inset] = heroImages;
---

<section id="home" class="max-w-7xl mx-auto px-5 md:px-10 pt-10 md:pt-16 pb-20">
  <div class="grid lg:grid-cols-12 gap-10 lg:gap-6 items-end">
    <div class="lg:col-span-6 lg:pb-16">
      <p class="kicker mb-8">{business.location} &mdash; Made by hand</p>
      <h1 class="font-display font-normal text-[3.4rem] sm:text-7xl xl:text-[6.5rem] leading-[0.92] tracking-[-0.02em] mb-10">
        Sweet things,<br />
        <em class="text-taupe">precisely</em> made.
      </h1>
      <div class="flex flex-col sm:flex-row sm:items-center gap-8 sm:gap-12">
        <p class="max-w-xs text-mute leading-relaxed text-[15px]">{business.pitch}</p>
        <a href={primaryCta.href} target="_blank" rel="noopener" class="link-draw shrink-0 self-start sm:self-center">
          Begin an enquiry <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <div class="lg:col-span-6 relative">
      <div class="aspect-[4/5] overflow-hidden">
        <Picture src={main.src} alt={main.alt} widths={[500, 800, 1200]} sizes="(min-width: 1024px) 600px, 100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" class="w-full h-full object-cover" />
      </div>
      <figure class="hidden sm:block absolute right-6 -bottom-10 w-40 lg:w-48 border-[10px] border-ivory shadow-xl">
        <Picture src={inset.src} alt={inset.alt} widths={[260, 420]} sizes="208px" formats={['avif', 'webp']} loading="eager" class="w-full aspect-[3/4] object-cover" />
      </figure>
      <p class="kicker !text-mute mt-4">Fig. 01 &mdash; {main.caption}</p>
    </div>
  </div>
</section>
