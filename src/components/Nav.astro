---
import InstagramIcon from './InstagramIcon.astro';
import { business, instagram, primaryCta } from '../data/site';

const navLinks = [
  { href: '#gallery', label: 'Gallery' },
  { href: '#menu', label: 'Menu' },
  { href: '#how-to-order', label: 'How to Order' },
  { href: '#about', label: 'About' },
];
---

<nav class="sticky top-0 z-50 bg-cream/95 backdrop-blur border-b border-primary/10 shadow-sm">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between gap-6">
    <a href="#home" class="font-display text-lg font-semibold text-primary tracking-wide">
      {business.name}
    </a>

    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="text-charcoal/60 hover:text-primary transition-colors text-sm font-medium tracking-widest uppercase"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden md:flex items-center gap-4">
      <a
        href={instagram.url}
        target="_blank"
        rel="noopener"
        class="text-primary/70 hover:text-primary transition-colors"
        aria-label={`${business.name} on Instagram`}
      >
        <InstagramIcon size={20} />
      </a>
      <a
        href={primaryCta.href}
        target="_blank"
        rel="noopener"
        class="bg-primary text-cream text-xs font-semibold uppercase tracking-[0.18em] px-5 py-2.5 rounded hover:bg-primary/90 transition-colors"
      >
        Order
      </a>
    </div>

    <button
      id="menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2 -mr-2"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="block w-6 h-px bg-primary"></span>
      <span class="block w-6 h-px bg-primary"></span>
      <span class="block w-4 h-px bg-primary"></span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-primary/10 bg-cream">
    <ul class="flex flex-col px-6 py-5 gap-5">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="text-charcoal/60 hover:text-primary transition-colors text-sm font-medium tracking-widest uppercase"
          >
            {label}
          </a>
        </li>
      ))}
      <li>
        <a
          href={instagram.url}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 text-primary text-sm font-medium tracking-widest uppercase"
        >
          <InstagramIcon size={16} />
          {instagram.handle}
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
